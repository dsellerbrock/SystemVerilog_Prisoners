# ===========================================
# DSim Simulator Files
# ===========================================

# DSim work directory (contains all compiled objects)
dsim_work/

# DSim environment and log files
dsim.env
dsim.log
dvlcom.env
dvlcom.log

# Metrics database
metrics.db

# Shared objects and object files generated by DSim
*.so
*.o

# ===========================================
# Waveform Dumps
# ===========================================

# VCD waveform files (can be large, regenerate from simulation)
*.vcd

# FST waveform files (GTKWave compressed format)
*.fst

# FSDB waveform files (Verdi)
*.fsdb

# WLF waveform files (ModelSim/Questa)
*.wlf

# SHM waveform database (Xcelium)
*.shm/

# VPD waveform files (VCS)
*.vpd

# ===========================================
# Other Simulator Work Directories
# ===========================================

# ModelSim/Questa
work/
modelsim.ini
transcript
vsim.wlf

# Vivado Simulator (xsim)
xsim.dir/
*.pb
*.wdb

# VCS
simv
simv.daidir/
csrc/
ucli.key

# Xcelium/Incisive
xcelium.d/
INCA_libs/
cds.lib
hdl.var

# Verilator
obj_dir/

# ===========================================
# General Build Artifacts
# ===========================================

# Log files
*.log

# Backup files
*~
*.bak
*.orig

# OS generated files
.DS_Store
Thumbs.db

# Editor/IDE files
*.swp
*.swo
.vscode/
.idea/
*.sublime-*

# ===========================================
# Coverage Data (regenerate from simulation)
# ===========================================
*.ucdb
urgReport/
coverage/
cov_work/