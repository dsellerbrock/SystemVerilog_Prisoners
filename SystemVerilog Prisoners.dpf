---
# Note: The contents of this file are automatically generated.
# Any changes made by hand may be overwritten.
version: '0.2'
work_dir: .
design_root_dir: .
simulations:
  - name: box_sim
    options: +acc -top work.tb_box_top -waves waaves/box.vcd
  - name: prisoner_sim
    options: +acc -top work.tb_prisoner_top -waves waves/prisoner.vcd
  - name: neotrng
    options: >-
      +acc -top work.neoTRNG_tb -waves waves/neotrng.vcd -run-until 100us
      +VERBOSE +REPORT
source_files:
  - language: vhdl
    path: neoTRNG/sim/neoTRNG_tb.vhd
  - language: vhdl
    path: neoTRNG/rtl/neoTRNG.vhd
  - language: verilog
    path: sim/box_tb.sv
  - language: verilog
    path: sim/multi_prisoner_tb.sv
  - language: verilog
    path: sim/prisoner_tb.sv
  - language: verilog
    path: rtl/box.v
  - language: verilog
    path: rtl/prisoner.v
library_search_paths:
  - $STD_LIBS/ieee93
